# Banco de dados (PostgreSQL - perfil prod/docker)
POSTGRES_DB=mymita
POSTGRES_USER=mymita
POSTGRES_PASSWORD=mymita_secret_dev

# Spring Boot
SPRING_PROFILES_ACTIVE=local
JWT_SECRET=MyMitaSuperSecretKeyForJwtSigning2026Minimum256BitsLong!
JWT_EXPIRATION_MS=86400000

# Google Gemini API (vazio = modo sandbox inteligente local)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Gateway de Pagamento - Stripe / Mercado Pago (vazio = modo sandbox)
PAYMENT_PROVIDER=sandbox
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
MERCADOPAGO_ACCESS_TOKEN=

# Front-end
VITE_API_URL=http://localhost:8081/api/v1
